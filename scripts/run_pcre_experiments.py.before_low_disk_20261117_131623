"""Preflight and a detached, single-GPU PCRE experiment queue.

Run from the repository root. No old output or source file is deleted/replaced.
"""
import argparse
from datetime import datetime, timezone
import importlib.metadata
import importlib.util
import json
import math
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time
import uuid

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))


def now():
    return datetime.now(timezone.utc).isoformat()


def event(directory, stage, **fields):
    record = dict(time=now(), stage=stage, **fields)
    with (directory / 'queue_events.jsonl').open('a') as stream:
        stream.write(json.dumps(record) + '\n')
    print(json.dumps(record), flush=True)


def arguments(options):
    result = []
    for key, value in options.items():
        result.append('--' + key)
        result.extend(str(v) for v in value) if isinstance(value, list) else result.append(str(value))
    return result


def preflight(config):
    import numpy as np
    import torch
    dependencies = ['torch', 'torchvision', 'numpy', 'scipy', 'matplotlib',
                    'pillow', 'imageio', 'timm', 'scikit-learn', 'fvcore',
                    'texttable', 'wandb', 'tqdm', 'psutil']
    versions = {name: importlib.metadata.version(name) for name in dependencies}
    import bilateralfilter
    options = config['common']
    data = ROOT / options['data_folder']
    lists = ROOT / options['list_folder']
    split_ids = {split: np.loadtxt(lists / (split + '.txt'), dtype=str).reshape(-1).tolist()
                 for split in ('train_aug', 'val')}
    overlap = set(split_ids['train_aug']) & set(split_ids['val'])
    if overlap:
        raise RuntimeError(f'Train/val overlap: {len(overlap)} images')
    tags = np.load(lists / 'cls_labels_onehot.npy', allow_pickle=True).item()
    for split, names in split_ids.items():
        if len(names) != len(set(names)):
            raise RuntimeError(f'Duplicate image IDs in {split}')
        for name in names:
            for path in (data / 'JPEGImages' / (name + '.jpg'),
                         data / 'SegmentationClassAug' / (name + '.png')):
                if not path.is_file():
                    raise FileNotFoundError(path)
            if name not in tags or np.asarray(tags[name]).shape != (20,):
                raise RuntimeError(f'Missing/invalid class tags: {name}')
    checkpoint = ROOT / 'pretrained/checkpoints/jx_vit_base_p16_224-80ecf9dd.pth'
    if not checkpoint.is_file():
        raise FileNotFoundError(checkpoint)
    spec = importlib.util.spec_from_file_location('pcre_experiment_trainer', ROOT / 'scripts/train_voc_adaptive.py')
    trainer = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(trainer)
    args = trainer.parser.parse_args(arguments(options))
    criterion = trainer.MyGo_Loss2(cnt_t=args.cnt_t, iou_score_t=args.bin_t,
                                  topk=args.wsddn_topk, cls_sc_t=args.cls_sc_t,
                                  high_t=args.prog_high_t, low_t=args.prog_low_t)
    model, _ = trainer.build_network_wsddn(args, criterion)
    model_bytes = sum(t.numel() * t.element_size() for t in model.state_dict().values())
    model_slots = len(set(range(args.eval_iters, args.max_iters + 1, args.eval_iters)) |
                      set(range(args.checkpoint_iters, args.max_iters + 1, args.checkpoint_iters)) |
                      {args.max_iters})
    full_slots = math.ceil(args.max_iters / args.checkpoint_iters)
    per_run = int(model_bytes * (model_slots + 2.1 * full_slots))
    # Include the GPU smoke snapshot and a 2 GiB filesystem reserve.
    budget = int(1.1 * per_run * len(config['modes']) + model_bytes * 3.5 + 2 * 1024 ** 3)
    free = shutil.disk_usage(ROOT).free
    if free < budget:
        raise RuntimeError(f'Checkpoint budget {budget / 1024**3:.2f} GiB exceeds {free / 1024**3:.2f} GiB free')
    return dict(time=now(), python=sys.executable, versions=versions,
                cuda_available=torch.cuda.is_available(), torch_cuda=torch.version.cuda,
                bilateralfilter=bilateralfilter.__file__, dataset=str(data.resolve()),
                split_counts={k: len(v) for k, v in split_ids.items()},
                train_val_overlap=len(overlap), model_parameters=sum(p.numel() for p in model.parameters()),
                per_run_storage_gib=per_run / 1024**3, model_checkpoint_gib=model_bytes / 1024**3, disk_free_gib=free / 1024**3,
                estimated_queue_storage_gib=budget / 1024**3,
                note='Reuse installed dependencies; no packages replaced. Storage is a conservative estimate.')


def gpu_state(config):
    result = subprocess.run(['nvidia-smi', '-i', str(config['gpu']),
                             '--query-gpu=memory.free,utilization.gpu',
                             '--format=csv,noheader,nounits'],
                            capture_output=True, text=True, check=True)
    free, utilization = result.stdout.strip().split(',')
    return {'free_mb': int(free.strip()), 'utilization': int(utilization.strip())}


def wait_gpu(config, directory):
    deadline = time.monotonic() + config['max_gpu_wait_hours'] * 3600
    stable = 0
    while time.monotonic() < deadline:
        if (directory / 'STOP').exists():
            raise RuntimeError('Queue stopped by STOP file')
        state = gpu_state(config)
        enough = state['free_mb'] >= config['min_free_gpu_mb']
        quiet = state['utilization'] <= config['max_gpu_utilization']
        stable = stable + 1 if enough and quiet else 0
        event(directory, 'gpu_ready' if stable >= config['gpu_stable_checks'] else 'waiting_for_gpu',
              stable_checks=stable, **state)
        if stable >= config['gpu_stable_checks']:
            return
        time.sleep(config['gpu_poll_seconds'])
    raise TimeoutError('GPU did not become available within the configured wait window')


def run_training(config, directory, mode, smoke=False):
    options = dict(config['common'])
    run_dir = directory / ('smoke_adaptive' if smoke else mode)
    options.update(experiment_mode=mode, run_dir=str(run_dir),
                   log_tag='smoke' if smoke else mode, wandb_name=directory.name + '_' + mode)
    if smoke:
        options.update(max_iters=4, eval_iters=4, checkpoint_iters=4, log_iters=1,
                       seg_warmup=0, seg_iter=2, update_prototype=0,
                       adaptive_warmup=0, adaptive_ramp=0, val_limit=2)
    command = [sys.executable, '-m', 'torch.distributed.run', '--standalone', '--nproc_per_node=1',
               'scripts/train_voc_adaptive.py', *arguments(options), '--save_ckpt']
    env = dict(os.environ, CUDA_VISIBLE_DEVICES=str(config['gpu']), WANDB_MODE='disabled' if smoke else 'offline',
               MPLBACKEND='Agg', OMP_NUM_THREADS='2', PYTHONUNBUFFERED='1')
    console_path = directory / ('smoke.console.log' if smoke else mode + '.console.log')
    with console_path.open('x') as stream:
        child = subprocess.Popen(command, cwd=ROOT, env=env, stdout=stream, stderr=subprocess.STDOUT)
        event(directory, 'smoke_running' if smoke else 'training_running', mode=mode,
              pid=child.pid, command=command, run_dir=str(run_dir))
        code = child.wait()
    if code:
        raise RuntimeError(f'{mode} exited with code {code}; see {console_path}')
    event(directory, 'smoke_completed' if smoke else 'training_completed', mode=mode, run_dir=str(run_dir))


def worker(config, directory):
    try:
        wait_gpu(config, directory)
        run_training(config, directory, 'adaptive', smoke=True)
        for mode in config['modes']:
            wait_gpu(config, directory)
            run_training(config, directory, mode)
        event(directory, 'completed')
    except Exception as error:
        event(directory, 'failed', error=str(error))
        raise


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', default='configs/pcre_adaptive_experiments.json')
    parser.add_argument('--check', action='store_true', help='CPU dependency/data/model/storage preflight only')
    parser.add_argument('--detach', action='store_true')
    parser.add_argument('--worker', action='store_true', help=argparse.SUPPRESS)
    parser.add_argument('--job_dir', default='', help=argparse.SUPPRESS)
    args = parser.parse_args()
    os.chdir(ROOT)
    config = json.loads(Path(args.config).read_text())
    if args.worker:
        worker(config, Path(args.job_dir))
        return
    result = preflight(config)
    if args.check:
        print(json.dumps(result, indent=2))
        return
    identifier = datetime.now(timezone.utc).strftime('%Y%m%d_%H%M%S') + '_' + uuid.uuid4().hex[:6]
    directory = ROOT / 'experiments' / ('pcre_sat_' + identifier)
    directory.mkdir(parents=True, exist_ok=False)
    (directory / 'preflight.json').write_text(json.dumps(result, indent=2) + '\n')
    (directory / 'queue_config.json').write_text(json.dumps(config, indent=2) + '\n')
    freeze = subprocess.run([sys.executable, '-m', 'pip', 'freeze'], capture_output=True, text=True)
    (directory / 'environment_freeze.txt').write_text(freeze.stdout)
    event(directory, 'created', job_dir=str(directory), preflight=result)
    if args.detach:
        with (directory / 'supervisor.log').open('x') as stream:
            child = subprocess.Popen([sys.executable, '-u', str(Path(__file__).resolve()),
                                      '--config', str(directory / 'queue_config.json'),
                                      '--worker', '--job_dir', str(directory)],
                                     cwd=ROOT, stdin=subprocess.DEVNULL, stdout=stream,
                                     stderr=subprocess.STDOUT, start_new_session=True)
        (directory / 'supervisor.pid').write_text(str(child.pid) + '\n')
        print(json.dumps({'supervisor_pid': child.pid, 'job_dir': str(directory)}), flush=True)
    else:
        worker(config, directory)


if __name__ == '__main__':
    main()
